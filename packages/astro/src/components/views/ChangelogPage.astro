---
/**
 * Every changelog entry, newest first, each with an anchor (`#<slug>`). The
 * headings inside an entry get ids scoped to it (`#<slug>-added`), so two
 * releases with an "Added" section don't share an id.
 */
import Layout from '../Layout.astro';
import PageHeader from '../PageHeader.astro';
import Prose from '../Prose.astro';
import { changelogAnchors, versionLabel } from '../../runtime/changelog';
import { scopeIds } from '../../runtime/headings';
import type { Site } from '../../runtime/site';

export interface Props {
  site: Site;
}

const { site } = Astro.props;
const renderer = site.renderer();
const anchors = changelogAnchors(site.changelog.map((e) => e.slug));
const entries = await Promise.all(
  site.changelog.map(async (entry, i) => {
    const anchor = anchors[i] ?? entry.slug;
    return { entry, anchor, version: versionLabel(entry.version), html: scopeIds(await renderer.mdx(entry.content), anchor) };
  }),
);
const toc = entries.map(({ entry, anchor }) => ({ depth: 2, text: entry.title, slug: anchor }));
---

<Layout
  site={site}
  title="Changelog"
  active={{ kind: 'changelog' }}
  sidebar={null}
  toc={toc}
  contentType="changelog"
  pageCss={renderer.styles.css}
  diagrams={entries.some(({ html }) => html.includes('data-fw-mermaid'))}
>
  <PageHeader title="Changelog" />
  {
    entries.map(({ entry, anchor, version, html }) => (
      <article class="fw-changelog-entry">
        <p class="fw-page-meta">
          {entry.date ? <time datetime={entry.date}>{entry.date}</time> : null}
          {entry.date && version ? ' · ' : null}
          {version ? <span class="fw-changelog-version">{version}</span> : null}
        </p>
        <h2 class="fw-changelog-title" id={anchor}>
          {entry.title}
        </h2>
        <Prose html={html} />
      </article>
    ))
  }
</Layout>
